{
  "name": "helm-terminal",
  "productName": "HELM",
  "version": "1.0.0",
  "buildNumber": "1",
  "releaseType": "stable",
  "description": "HELM - AI-powered terminal. Powered by LANA AI.",
  "main": "dist/main/main.js",
  "author": {
    "name": "RedRooster Technologies Inc.",
    "email": "info@redroostertec.com"
  },
  "license": "Proprietary",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite --port 5173",
    "dev:electron": "sleep 2 && tsc -p tsconfig.main.json && rm -rf dist/main/mobile-pwa && cp -r src/main/mobile-pwa dist/main/mobile-pwa && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.main.json && rm -rf dist/main/mobile-pwa && cp -r src/main/mobile-pwa dist/main/mobile-pwa",
    "build:client": "electron-builder -c electron-builder.client.json",
    "build:mac": "electron-builder --mac -c electron-builder.client.json",
    "build:mac-arm64": "electron-builder --mac --arm64 -c electron-builder.client.json",
    "build:mac-x64": "electron-builder --mac --x64 -c electron-builder.client.json",
    "build:win": "electron-builder --win -c electron-builder.client.json",
    "build:linux": "electron-builder --linux -c electron-builder.client.json",
    "build:all": "electron-builder --mac --x64 --arm64 --win --linux -c electron-builder.client.json",
    "release": "./scripts/build-client.sh",
    "start": "electron .",
    "setup:db": "./scripts/setup-database.sh",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [
    "terminal",
    "helm",
    "lana-ai",
    "ai-terminal",
    "education",
    "learning"
  ],
  "devDependencies": {
    "@types/node": "20.19.27",
    "@types/pg": "8.16.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "8.2.2",
    "electron": "28.3.3",
    "electron-builder": "25.1.8",
    "electron-rebuild": "3.2.9",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.78.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "5.5.0",
    "dotenv": "17.3.1",
    "node-pty": "1.1.0",
    "openai": "6.29.0",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "ws": "8.18.0"
  }
}
