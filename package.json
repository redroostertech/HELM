{
  "name": "helm-terminal",
  "version": "0.1.0",
  "description": "HELM - AI-powered terminal. Powered by LANA AI.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite --port 5173",
    "dev:electron": "sleep 2 && tsc -p tsconfig.main.json && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:mac-arm64": "electron-builder --mac --arm64",
    "package:mac-x64": "electron-builder --mac --x64",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux",
    "release": "./scripts/build-client.sh",
    "start": "electron .",
    "setup:db": "./scripts/setup-database.sh",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [
    "terminal",
    "helm",
    "lana-ai",
    "ai-terminal",
    "education",
    "learning"
  ],
  "author": "RedRooster Technologies Inc.",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^17.3.1",
    "node-pty": "^1.1.0",
    "openai": "^6.29.0",
    "pg": "^8.13.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "build": {
    "appId": "com.redrooster.helm",
    "productName": "HELM",
    "copyright": "Copyright (c) 2026 RedRooster Technologies Inc.",
    "artifactName": "HELM-${version}-${arch}.${ext}",
    "icon": "build/icon.icns",
    "protocols": [
      {
        "name": "HELM",
        "schemes": ["helm"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "redroostertech",
      "repo": "HELM",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HELM",
      "artifactName": "HELM-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  }
}
