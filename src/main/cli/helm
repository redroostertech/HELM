  IPC socket:   ${SOCKET_PATH}

INSTALL & UPDATES
  To install this shim on your PATH, open HELM and choose
  "HELM → Install CLI…" from the menu bar. It will create a
  symlink in ~/.local/bin, ~/bin, or /usr/local/bin.

  Updates are automatic: the symlink points into the HELM app
  bundle, so app updates replace the shim in place. No action
  needed unless you move or reinstall HELM.app.

  Run "helm doctor" any time to verify your install is healthy,
  and "helm version" to check the shim matches the app.

  Manual install:
    ln -sf "<path-to-helm-shim>" ~/.local/bin/helm

SEE ALSO
  helm snapshots            # list saved snapshots
  helm list                 # list active tabs
`);
}

// ── entry ─────────────────────────────────────────────────────────

async function main() {
  const [, , cmd, ...rest] = process.argv;

  if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') {
    printHelp();
    return;
  }

  if (cmd === '--version' || cmd === '-v') {
    return await cmdVersion();
  }

  try {
    switch (cmd) {
      case 'snapshot': return await cmdSnapshot(rest);
      case 'restore':  return await cmdRestore(rest);
      case 'open':     return await cmdOpen(rest);
      case 'run':      return await cmdRun(rest);
      case 'list':     return await cmdList();
      case 'snapshots': return cmdSnapshots();
      case 'cruise':   return await cmdCruise(rest);
      case 'version': return await cmdVersion();
      case 'doctor':  return await cmdDoctor();
      default:
        console.error(`Unknown command: ${cmd}`);
        printHelp();
        process.exit(1);
    }
  } catch (err) {
    console.error('Error:', err.message || err);
    process.exit(1);
  }
}

main();
