#!/usr/bin/env node
/**
 * helm — CLI shim for the HELM terminal app.
 *
 * Connects to the running HELM app via a Unix domain socket and sends
 * newline-delimited JSON requests. If HELM is not running, launches it
 * and waits for the socket to appear.
 *
 * This file is plain JS and uses only Node core modules so it runs
 * without npm install.
 */
'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const net = require('net');
const { execSync, spawnSync } = require('child_process');

// Shim version — bumped when the helm CLI protocol or features change.
// If this diverges from the running app's version, `helm doctor` warns.
const SHIM_VERSION = '1.0.0';

const APP_SUPPORT = path.join(os.homedir(), 'Library', 'Application Support', 'Helm');
const SOCKET_PATH = path.join(APP_SUPPORT, 'helm.sock');
const SNAPSHOT_DIR = path.join(APP_SUPPORT, 'snapshots');

// ── env filtering (allowlist with denylist second-pass) ──────────

// Exact names that are always safe to forward
const ALLOW_EXACT = new Set([
  // locale / i18n
  'LANG', 'LANGUAGE', 'LC_ALL', 'LC_COLLATE', 'LC_CTYPE', 'LC_MESSAGES',
  'LC_MONETARY', 'LC_NUMERIC', 'LC_TIME', 'TZ',
  // terminal / display
  'TERM', 'COLORTERM', 'TERM_PROGRAM', 'TERM_PROGRAM_VERSION',
  // paths
  'PATH', 'MANPATH', 'INFOPATH', 'LD_LIBRARY_PATH', 'DYLD_LIBRARY_PATH',
  'PKG_CONFIG_PATH', 'CPATH', 'LIBRARY_PATH',
  // shell / user
  'SHELL', 'EDITOR', 'VISUAL', 'PAGER', 'LESS', 'MANPAGER',
  'USER', 'LOGNAME', 'HOME', 'HOSTNAME',
  // platform
  'OSTYPE', 'MACHTYPE', 'CPUTYPE', 'VENDOR', 'OSVERSION',
  // version managers — paths (not tokens)
  'NVM_DIR', 'NVM_BIN', 'NVM_INC', 'NVM_CD_FLAGS', 'NODE_PATH', 'NODE_VERSION',
  'PYENV_ROOT', 'PYENV_VERSION', 'PYENV_SHELL',
  'RBENV_ROOT', 'RBENV_VERSION', 'RBENV_SHELL',
  'GOPATH', 'GOROOT', 'GOBIN', 'GOPROXY', 'GO111MODULE',
  'CARGO_HOME', 'RUSTUP_HOME',
  'JAVA_HOME', 'M2_HOME', 'GRADLE_HOME',
  // python
  'VIRTUAL_ENV', 'CONDA_PREFIX', 'CONDA_DEFAULT_ENV', 'CONDA_SHLVL',
  'PYTHONPATH', 'PYTHONDONTWRITEBYTECODE', 'PYTHONUNBUFFERED',
  // ssh (socket paths — not keys)
  'SSH_AUTH_SOCK', 'SSH_AGENT_PID',
  // homebrew
  'HOMEBREW_PREFIX', 'HOMEBREW_CELLAR', 'HOMEBREW_REPOSITORY',
  // misc dev
  'DOCKER_HOST', 'COMPOSE_PROJECT_NAME', 'KUBECONFIG',
  'XDG_CONFIG_HOME', 'XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_RUNTIME_DIR',
  'TMPDIR', 'TMP', 'TEMP',
]);

// Prefixes of names that are always safe
const ALLOW_PREFIXES = [
  'LC_',   // additional locale categories
  'LESS_', // less pager config
];

// Denylist (secondary — catches anything that slips through by name)
const DENY_PATTERNS = [
  /TOKEN/i, /KEY/i, /SECRET/i, /PASSWORD/i, /PASSWD/i, /PRIVATE/i,
  /CREDENTIAL/i, /COOKIE/i, /BEARER/i, /_PAT$/i, /AUTH/i,
];

function isAllowed(name) {
  if (ALLOW_EXACT.has(name)) return true;
  for (const prefix of ALLOW_PREFIXES) {
    if (name.startsWith(prefix)) return true;
  }
  return false;
}

function looksLikeSecret(name) {
  for (const pat of DENY_PATTERNS) {
    if (pat.test(name)) return true;
  }
  return false;
}

function filterEnv(env) {
  const out = {};
  for (const [k, v] of Object.entries(env)) {
    if (typeof v !== 'string') continue;
    if (!isAllowed(k)) continue;
    // Second-pass defense: if an allowlisted name still matches a secret
    // pattern (e.g. someone named their custom SSH_KEY_PATH), drop it.
    if (looksLikeSecret(k)) continue;
    out[k] = v;
  }
  return out;
}

// ── history capture ───────────────────────────────────────────────

function captureHistory() {
  const shell = process.env.SHELL || '';
  const home = os.homedir();
  let histfile = '';
  const isZsh = /zsh$/.test(shell);
  const isBash = /bash$/.test(shell);

  if (isZsh) {
    histfile = process.env.HISTFILE || path.join(home, '.zsh_history');
  } else if (isBash) {
    histfile = process.env.HISTFILE || path.join(home, '.bash_history');
  } else {
    return [];
  }

  try {
    if (!fs.existsSync(histfile)) return [];
    const raw = fs.readFileSync(histfile, 'utf-8');
    const lines = raw.split('\n').filter(Boolean);
    // zsh extended history format: ": <epoch>:<duration>;<cmd>"
    const parsed = lines.map(line => {
      const m = line.match(/^:\s*\d+:\d+;(.*)$/);
      return m ? m[1] : line;
    }).filter(l => l.trim().length > 0);
    return parsed.slice(-50);
  } catch {
    return [];
  }
}

// ── git info ──────────────────────────────────────────────────────

function captureGit(cwd) {
  try {
    const root = execSync('git rev-parse --show-toplevel', { cwd, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
    const branch = execSync('git rev-parse --abbrev-ref HEAD', { cwd, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
    return { root, branch };
  } catch {
    return null;
  }
}

// ── env-manager markers ───────────────────────────────────────────

function captureEnvManagers() {
  const out = {};
  if (process.env.VIRTUAL_ENV) out.venv = process.env.VIRTUAL_ENV;
  if (process.env.CONDA_PREFIX) out.conda = process.env.CONDA_PREFIX;
  if (process.env.NVM_BIN) out.nvm = process.env.NVM_BIN;
  if (process.env.PYENV_VERSION) out.pyenv = process.env.PYENV_VERSION;
  if (process.env.RBENV_VERSION) out.rbenv = process.env.RBENV_VERSION;
  return out;
}

// ── snapshot creation ─────────────────────────────────────────────

function buildSnapshot(name) {
  const cwd = process.cwd();
  return {
    version: 1,
    createdAt: new Date().toISOString(),
    name: name || null,
    shell: process.env.SHELL || '/bin/zsh',
    cwd,
    env: filterEnv(process.env),
    history: captureHistory(),
    git: captureGit(cwd),
    envManagers: captureEnvManagers(),
  };
}

function ensureDir(dir) {
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
}

function writeSnapshot(snapshot, name) {
  ensureDir(SNAPSHOT_DIR);
  const id = name || `snap-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
  const filePath = path.join(SNAPSHOT_DIR, `${id}.json`);
  fs.writeFileSync(filePath, JSON.stringify(snapshot, null, 2), { mode: 0o600 });
  return { id, filePath };
}

// ── socket client ─────────────────────────────────────────────────

function connectSocket(timeoutMs = 500) {
  return new Promise((resolve, reject) => {
    const sock = net.createConnection(SOCKET_PATH);
    const to = setTimeout(() => {
      sock.destroy();
      reject(new Error('timeout'));
    }, timeoutMs);
    sock.once('connect', () => { clearTimeout(to); resolve(sock); });
    sock.once('error', (err) => { clearTimeout(to); reject(err); });
  });
}

function sendRequest(req) {
  return new Promise(async (resolve, reject) => {
    let sock;
    try {
      sock = await connectSocket();
    } catch {
      // HELM not running — launch it, then wait for socket
      console.error('HELM is not running — launching it…');
      spawnSync('open', ['-a', 'HELM'], { stdio: 'ignore' });

      const deadline = Date.now() + 15000;
      while (Date.now() < deadline) {
        try {
          sock = await connectSocket(500);
          break;
        } catch {
          await new Promise(r => setTimeout(r, 300));
        }
      }
      if (!sock) {
        return reject(new Error('Could not connect to HELM after launch. Is HELM installed?'));
      }
    }

    let buf = '';
    sock.on('data', (d) => {
      buf += d.toString('utf-8');
      const nl = buf.indexOf('\n');
      if (nl !== -1) {
        const line = buf.slice(0, nl);
        try {
          const resp = JSON.parse(line);
          sock.end();
          resolve(resp);
        } catch (e) {
          sock.end();
          reject(new Error('Invalid response from HELM: ' + e.message));
        }
      }
    });
    sock.on('error', (err) => reject(err));
    sock.on('end', () => {
      if (!buf) reject(new Error('HELM closed connection with no response'));
    });

    sock.write(JSON.stringify(req) + '\n');
  });
}

// ── subcommands ───────────────────────────────────────────────────

async function cmdSnapshot(args) {
  let name = null;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--name' && i + 1 < args.length) {
      name = args[i + 1];
      i++;
    }
  }
  const snap = buildSnapshot(name);
  const { id, filePath } = writeSnapshot(snap, name);
  console.log(`Snapshot saved: ${id}`);
  console.log(`  ${filePath}`);

  const resp = await sendRequest({ op: 'open-snapshot', snapshotPath: filePath });
  if (resp.ok) {
    console.log(`Opened HELM tab (${resp.tabId})`);
  } else {
    console.error('Failed to open HELM tab:', resp.error);
    process.exit(1);
  }
}

async function cmdRestore(args) {
  const name = args[0];
  if (!name) {
    console.error('usage: helm restore <name>');
    process.exit(1);
  }
  const filePath = path.join(SNAPSHOT_DIR, `${name}.json`);
  if (!fs.existsSync(filePath)) {
    console.error(`No snapshot found: ${name}`);
    process.exit(1);
  }
  const resp = await sendRequest({ op: 'open-snapshot', snapshotPath: filePath });
  if (resp.ok) {
    console.log(`Opened HELM tab (${resp.tabId}) from snapshot ${name}`);
  } else {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
}

async function cmdOpen(args) {
  const target = args[0] || '.';
  const abs = path.resolve(target);
  if (!fs.existsSync(abs)) {
    console.error(`Path does not exist: ${abs}`);
    process.exit(1);
  }
  const resp = await sendRequest({ op: 'open-path', cwd: abs });
  if (resp.ok) {
    console.log(`Opened HELM tab (${resp.tabId}) at ${abs}`);
  } else {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
}

async function cmdRun(args) {
  const command = args.join(' ').trim();
  if (!command) {
    console.error('usage: helm run "<command>"');
    process.exit(1);
  }
  const resp = await sendRequest({ op: 'run', cwd: process.cwd(), command });
  if (resp.ok) {
    console.log(`Opened HELM tab (${resp.tabId}) running: ${command}`);
  } else {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
}

async function cmdList() {
  const resp = await sendRequest({ op: 'list-tabs' });
  if (!resp.ok) {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
  const tabs = resp.tabs || [];
  if (tabs.length === 0) {
    console.log('(no tabs)');
    return;
  }
  for (const t of tabs) {
    console.log(`${t.id}  ${t.label || ''}${t.description ? '  — ' + t.description : ''}`);
  }
}

async function cmdVersion() {
  console.log(`helm shim ${SHIM_VERSION}`);
  try {
    const resp = await sendRequest({ op: 'version' });
    if (resp.ok) {
      console.log(`HELM app  ${resp.appVersion}`);
      if (resp.shimVersion && resp.shimVersion !== SHIM_VERSION) {
        console.log('');
        console.log(`⚠️  Shim is out of date (app bundles shim ${resp.shimVersion}).`);
        console.log('   Run "HELM → Install CLI…" from the app menu to refresh.');
      }
    }
  } catch {
    console.log('(HELM app not running — could not check app version)');
  }
}

async function cmdDoctor() {
  let problems = 0;
  const ok = (msg) => console.log(`  ✓ ${msg}`);
  const bad = (msg) => { console.log(`  ✗ ${msg}`); problems++; }
  const warn = (msg) => console.log(`  ! ${msg}`);

  console.log('helm doctor — checking install health\n');

  // 1. Shim location
  console.log('shim:');
  const shimPath = __filename;
  ok(`running from ${shimPath}`);
  ok(`version ${SHIM_VERSION}`);

  // 2. Is helm on PATH?
  console.log('\nPATH:');
  let onPathResolved = null;
  try {
    onPathResolved = execSync('command -v helm 2>/dev/null', { encoding: 'utf-8' }).trim();
  } catch {}
  if (onPathResolved) {
    ok(`helm resolves to ${onPathResolved}`);
    // Check if the symlink target still exists
    try {
      const st = fs.lstatSync(onPathResolved);
      if (st.isSymbolicLink()) {
        const target = fs.readlinkSync(onPathResolved);
        if (!fs.existsSync(target)) {
          bad(`symlink target missing: ${target}`);
          console.log('    → re-run "HELM → Install CLI…" from the app menu');
        } else {
          ok(`symlink target exists: ${target}`);
        }
      }
    } catch {}
  } else {
    bad('"helm" is not on your PATH');
    console.log('    → run "HELM → Install CLI…" from the app menu');
  }

  // 3. Socket / app connectivity
  console.log('\nHELM app:');
  if (fs.existsSync(SOCKET_PATH)) {
    ok(`socket exists at ${SOCKET_PATH}`);
    try {
      const resp = await sendRequest({ op: 'version' });
      if (resp.ok) {
        ok(`app reachable (HELM ${resp.appVersion})`);
        if (resp.shimVersion && resp.shimVersion !== SHIM_VERSION) {
          warn(`app bundles shim ${resp.shimVersion}, you are running ${SHIM_VERSION}`);
          console.log('    → run "HELM → Install CLI…" to refresh the symlink');
        } else {
          ok('shim matches app');
        }
      } else {
        bad(`app responded with error: ${resp.error}`);
      }
    } catch (err) {
      bad(`could not talk to app: ${err.message || err}`);
    }
  } else {
    warn('socket does not exist (HELM is not running)');
    console.log(`    → launch HELM, then run "helm doctor" again`);
  }

  // 4. Snapshot dir
  console.log('\nsnapshots:');
  if (fs.existsSync(SNAPSHOT_DIR)) {
    const files = fs.readdirSync(SNAPSHOT_DIR).filter(f => f.endsWith('.json'));
    ok(`snapshot dir exists (${files.length} saved)`);
  } else {
    warn('snapshot dir does not exist yet (created on first snapshot)');
  }

  console.log(problems === 0 ? '\n✓ all good' : `\n✗ ${problems} problem${problems === 1 ? '' : 's'} found`);
  if (problems > 0) process.exit(1);
}

// ── cruise control ───────────────────────────────────────────────

async function cmdCruise(args) {
  const sub = args[0];
  if (!sub || sub === 'help' || sub === '--help' || sub === '-h') {
    printCruiseHelp();
    return;
  }
  switch (sub) {
    case 'start': return await cruiseStart(args.slice(1));
    case 'status': return await cruiseStatus(args.slice(1));
    case 'list': return await cruiseList();
    case 'pause': return await cruiseSimple('cruise-pause', args.slice(1));
    case 'resume': return await cruiseSimple('cruise-resume', args.slice(1));
    case 'stop': return await cruiseSimple('cruise-stop', args.slice(1));
    case 'approve': return await cruiseSimple('cruise-approve-prd', args.slice(1));
    default:
      console.error(`Unknown cruise subcommand: ${sub}`);
      printCruiseHelp();
      process.exit(1);
  }
}

function printCruiseHelp() {
  console.log(`helm cruise — agentic orchestration

USAGE
  helm cruise <subcommand> [args]

SUBCOMMANDS
  start <repo-path> [--auto-approve] [--max-cycles N]
      Start a new Cruise Control run on the given repository. The repo
      must contain AGENTS.md and PRD.md in its root. Spawns 3 agent
      tabs (PRD-refiner, Builder, Reviewer) and drives them through
      the orchestration phases.

      Examples:
        helm cruise start ~/code/my-project
        helm cruise start . --max-cycles 5

  status [run-id]
      Show the status of a Cruise run. With no id, shows the most
      recent active run.

  list
      List all Cruise runs.

  pause <run-id>
      Pause the orchestrator (CLIs stay alive).

  resume <run-id>
      Resume from pause OR from a stopped checkpoint.

  stop <run-id>
      Kill agent CLIs and save a checkpoint (resumable later).

  approve <run-id>
      Approve the PRD draft as-is (no edits) and move to build phase.
`);
}

async function cruiseStart(args) {
  if (!args[0]) {
    console.error('usage: helm cruise start <repo-path> [--auto-approve] [--max-cycles N]');
    process.exit(1);
  }
  const targetRepo = path.resolve(args[0]);
  if (!fs.existsSync(targetRepo)) {
    console.error(`repo path does not exist: ${targetRepo}`);
    process.exit(1);
  }
  if (!fs.existsSync(path.join(targetRepo, 'AGENTS.md'))) {
    console.error(`AGENTS.md not found in ${targetRepo}`);
    process.exit(1);
  }
  if (!fs.existsSync(path.join(targetRepo, 'PRD.md'))) {
    console.error(`PRD.md not found in ${targetRepo}`);
    process.exit(1);
  }
  let autoApprove = false;
  let maxCycles = 3;
  for (let i = 1; i < args.length; i++) {
    if (args[i] === '--auto-approve') autoApprove = true;
    else if (args[i] === '--max-cycles' && i + 1 < args.length) {
      maxCycles = parseInt(args[++i], 10) || 3;
    }
  }
  const resp = await sendRequest({
    op: 'cruise-start',
    config: { targetRepo, autoApprovePRD: autoApprove, maxReviewCycles: maxCycles },
  });
  if (resp.ok) {
    console.log(`Cruise run #${resp.runId} started on ${targetRepo}`);
    console.log('Open HELM to watch progress; agents will spawn shortly.');
  } else {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
}

async function cruiseStatus(args) {
  const runId = args[0] ? parseInt(args[0], 10) : null;
  const resp = await sendRequest({ op: 'cruise-status', runId });
  if (!resp.ok) {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
  if (!resp.run) {
    console.log('(no run)');
    return;
  }
  const r = resp.run;
  console.log(`#${r.id}  ${r.target_repo}`);
  console.log(`  status: ${r.status}`);
  console.log(`  phase:  ${r.current_phase}${r.review_cycle ? ` (review cycle ${r.review_cycle})` : ''}`);
  console.log(`  agents: ${resp.agents.length}`);
  for (const a of resp.agents) {
    console.log(`    - ${a.label || a.role}  [${a.status}]  ${a.program_id}${a.tab_id ? '  tab=' + a.tab_id : ''}`);
  }
  if (resp.events && resp.events.length) {
    console.log(`  recent events:`);
    for (const e of resp.events.slice(-5)) {
      console.log(`    ${e.ts.slice(11, 19)}  ${e.type}  ${e.phase}`);
    }
  }
}

async function cruiseList() {
  const resp = await sendRequest({ op: 'cruise-list' });
  if (!resp.ok) {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
  const runs = resp.runs || [];
  if (runs.length === 0) {
    console.log('(no runs)');
    return;
  }
  for (const r of runs) {
    const started = (r.started_at || '').slice(0, 19).replace('T', ' ');
    console.log(`#${String(r.id).padEnd(4)}  ${started}  ${r.status.padEnd(10)}  ${r.current_phase.padEnd(16)}  ${r.target_repo}`);
  }
}

async function cruiseSimple(op, args) {
  if (!args[0]) {
    console.error(`usage: helm cruise <op> <run-id>`);
    process.exit(1);
  }
  const runId = parseInt(args[0], 10);
  if (isNaN(runId)) {
    console.error(`invalid run id: ${args[0]}`);
    process.exit(1);
  }
  const resp = await sendRequest({ op, runId });
  if (resp.ok) {
    console.log(`ok`);
  } else {
    console.error('Failed:', resp.error);
    process.exit(1);
  }
}

function cmdSnapshots() {
  ensureDir(SNAPSHOT_DIR);
  const files = fs.readdirSync(SNAPSHOT_DIR).filter(f => f.endsWith('.json'));
  if (files.length === 0) {
    console.log('(no snapshots)');
    return;
  }
  const rows = files.map(f => {
    const p = path.join(SNAPSHOT_DIR, f);
    try {
      const snap = JSON.parse(fs.readFileSync(p, 'utf-8'));
      return { name: f.replace(/\.json$/, ''), createdAt: snap.createdAt || '', cwd: snap.cwd || '' };
    } catch {
      return { name: f.replace(/\.json$/, ''), createdAt: '', cwd: '' };
    }
  });
  rows.sort((a, b) => (b.createdAt || '').localeCompare(a.createdAt || ''));
  for (const r of rows) {
    const date = r.createdAt ? r.createdAt.slice(0, 19).replace('T', ' ') : '                   ';
    console.log(`${r.name.padEnd(32)}  ${date}  ${r.cwd}`);
  }
}

